---
interface Props {
  url: string;
}

const { url } = Astro.props;

let title = "";
let description = "";
let image = "";
let favicon = "";

try {
  const res = await fetch(url);
  const html = await res.text();

  function getMetaContent(property: string): string {
    const match = html.match(
      new RegExp(
        `<meta[^>]+(?:property|name)=["']${property}["'][^>]+content=["']([^"']*)["']`,
        "i",
      ),
    );
    if (match) {
      return match[1];
    }
    const reversed = html.match(
      new RegExp(
        `<meta[^>]+content=["']([^"']*)["'][^>]+(?:property|name)=["']${property}["']`,
        "i",
      ),
    );
    return reversed?.[1] ?? "";
  }

  title =
    getMetaContent("og:title") ||
    html.match(/<title[^>]*>([^<]*)<\/title>/i)?.[1] ||
    url;
  description =
    getMetaContent("og:description") || getMetaContent("description");
  image = getMetaContent("og:image");

  const origin = new URL(url).origin;
  favicon = `https://www.google.com/s2/favicons?domain=${origin}&sz=32`;
} catch {
  title = url;
}

const hostname = new URL(url).hostname;
---

<a href={url} class="link-card" target="_blank" rel="noopener noreferrer">
  {
    image && (
      <div class="ogimage">
        <img src={image} alt="" loading="lazy" />
      </div>
    )
  }
  <div class="content">
    <span class="title">{title}</span>
    {description && <span class="description">{description}</span>}
    <span class="hostname">
      {
        favicon && (
          <img src={favicon} alt="" width="16" height="16" loading="lazy" />
        )
      }
      {hostname}
    </span>
  </div>
</a>

<style>
  .link-card {
    display: flex;
    border: 1px solid var(--type-color);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s;
    margin: 1em 0;

    &:hover {
      border-color: var(--main-color);
    }
  }

  .ogimage {
    flex-shrink: 0;
    width: 200px;

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    min-width: 0;
  }

  .title {
    font-weight: bold;
    color: var(--main-color);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .description {
    font-size: 0.85em;
    color: var(--darker-type);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hostname {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8em;
    color: var(--darker-type);
    margin-top: auto;
  }

  @media (max-width: 500px) {
    .link-card {
      flex-direction: column;
    }

    .ogimage {
      width: 100%;
      height: 150px;
    }
  }
</style>
